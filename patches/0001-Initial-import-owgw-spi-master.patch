diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..15a4309
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,64 @@
+name: build
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+
+jobs:
+  build:
+    name: kernel ${{ matrix.kernel }}
+    runs-on: ubuntu-22.04
+    strategy:
+      fail-fast: false
+      matrix:
+        kernel:
+          - '4.19'
+          - '5.10'
+          - '5.15'
+          - '6.1'
+          - '6.6'
+          - '6.12'
+    steps:
+      - name: Checkout this repo
+        uses: actions/checkout@v4
+
+      - name: Install build deps
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            build-essential flex bison bc libssl-dev libelf-dev \
+            kmod cpio rsync git
+
+      - name: Clone kernel source (tag v${{ matrix.kernel }}.0)
+        run: |
+          git clone --depth 1 --branch v${{ matrix.kernel }}.0 \
+            https://github.com/torvalds/linux.git kernel
+
+      - name: Prepare kernel for out-of-tree build
+        working-directory: kernel
+        run: |
+          # Minimal config — just enough to build the IIO subsystem + SPI.
+          # We deliberately do not enable the driver here; it stays out-of-tree.
+          make defconfig
+          ./scripts/config --set-str LOCALVERSION "-owgw-spi-master-ci"
+          # Enable the IIO + SPI + regmap bits the driver depends on.
+          # NOTE: owgw-spi-master does NOT use CONFIG_IIO_BUFFER or
+          # CONFIG_REGULATOR, so we deliberately omit them here.
+          ./scripts/config --enable CONFIG_IIO
+          ./scripts/config --enable CONFIG_SPI
+          ./scripts/config --enable CONFIG_REGMAP
+          make modules_prepare
+
+      - name: Build out-of-tree module
+        run: |
+          make -C kernel M=$(pwd) \
+            ARCH=$(uname -m | sed 's/x86_64/x86/') \
+            CROSS_COMPILE= \
+            V=1
+
+      - name: Verify the .ko was produced
+        run: |
+          test -f owgw-spi-master.ko && \
+          echo "OK: built owgw-spi-master.ko" || \
+          (echo "FAIL: owgw-spi-master.ko missing"; exit 1)
